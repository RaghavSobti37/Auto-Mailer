{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://automailer-api.onrender.com/api/$1"
    },
    {
      "source": "/track/(.*)",
      "destination": "https://automailer-api.onrender.com/track/$1"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "https://automailer-api.onrender.com/webhooks/$1"
    },
    {
      "source": "/health",
      "destination": "https://automailer-api.onrender.com/health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Auto-Mailer-Frontend",
          "value": "vercel-static-console"
        }
      ]
    }
  ]
}
