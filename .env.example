# ============================================================
# Auto-Mailer — Environment Configuration (Production)
# ============================================================

# --- Data Sources ---
# Primary = local Docker Mongo (source of truth for dev)
MONGODB_URI=mongodb://localhost:27017/auto-mailer
LOCAL_MONGODB_URI=mongodb://localhost:27017/auto-mailer

# Atlas / CoreKnot prod — used by migrate-to-local + sync-worker (never commit real creds)
# COREKNOT_MONGODB_URI=mongodb+srv://<user>:<pass>@cluster/taskmaster_production
# Or leave unset: migrate scripts read MONGODB_URI from .env.render-backup.json (gitignored)
ATLAS_MONGODB_URI=

# --- Optional Online Backup ---
# Local MongoDB is the source of truth. Use Settings -> Back up now to write
# compressed gzip/EJSON chunks into this online MongoDB database.
ONLINE_BACKUP_MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/auto-mailer-backup
# Atlas project id → deep-link Data Explorer (Open local / Open online backup buttons)
# ATLAS_PROJECT_ID=64abc...
# Optional full URL overrides (skip auto Atlas URL builder)
# MONGO_LOCAL_OPEN_URL=https://cloud.mongodb.com/v2/<project>/explorer/<cluster>/<db>/automailer_people/find
# MONGO_BACKUP_OPEN_URL=https://cloud.mongodb.com/v2/<project>/explorer/<cluster>/<db>/_auto_mailer_backup_runs/find
# BACKUP_OPEN_COLLECTION=_auto_mailer_backup_runs

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Email Sending ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
SMTP_USER=
SMTP_PASS=

# --- Server ---
PORT=5001
FRONTEND_URL=http://localhost:5001
TRACKING_BASE_URL=https://auto-mailer-5e54.onrender.com
CORS_ORIGIN=*
NEXT_PUBLIC_LIVE_API_URL=https://auto-mailer-5e54.onrender.com
NEXT_PUBLIC_MIRROR_API_URL=https://auto-mailer-5e54.onrender.com

# --- Sender Identity ---
SYSTEM_VERIFIED_FROM_EMAIL=onboarding@resend.dev
SYSTEM_VIA_REPLY_TO=

# --- Auth ---
AUTO_MAILER_API_KEY=

# --- UploadThing banner uploads ---
# Keep the real token only in .env / hosting secrets. Do not commit live tokens.
UPLOADTHING_TOKEN=eyJhcGlLZXkiOiJza19saXZlX3...placeholder

# --- HolySheet (optional) ---
HOLYSHEET_API_KEY=
