# ============================================================
# Auto-Mailer — Environment Configuration (Production)
# ============================================================

# --- Data Sources ---
MONGODB_URI=mongodb://localhost:27017/auto-mailer

# --- Atlas / Local Mirror Sync ---
# Source of truth (writes go here — must always be reachable)
ATLAS_MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/auto-mailer
# Local read-only mirror (sync-worker copies Atlas -> local)
LOCAL_MONGODB_URI=mongodb://localhost:27017/auto-mailer-mirror

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Email Sending ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Server ---
PORT=5001
FRONTEND_URL=http://localhost:5001
CORS_ORIGIN=*

# --- Sender Identity ---
SYSTEM_VERIFIED_FROM_EMAIL=onboarding@resend.dev
SYSTEM_VIA_REPLY_TO=

# --- Auth ---
AUTO_MAILER_API_KEY=dev-key-123

# --- Backup ---
ONLINE_BACKUP_MONGODB_URI=
BACKUP_SCHEDULE_HOUR=2

# --- HolySheet (optional) ---
HOLYSHEET_API_KEY=
