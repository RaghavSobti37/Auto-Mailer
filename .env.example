# MongoDB
MONGODB_URI=mongodb://localhost:27017/auto-mailer

# Online Mongo backup (Atlas/remote MongoDB, never commit real URI)
ONLINE_BACKUP_MONGODB_URI=
BACKUP_SCHEDULE_HOUR=2

# Redis (for BullMQ campaign worker)
REDIS_URL=redis://localhost:6379

# Resend API (for sending emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# SMTP fallback (if Resend is not available)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# HolySheet (unsubscribe sync)
HOLYSHEET_API_KEY=Z2BhkUlsA5F-wq2GQ-g5fSYu-JgfHryt

# Frontend URL (for unsubscribe redirects)
FRONTEND_URL=http://localhost:5173

# Public backend URL for tracking links in outbound email
APP_BASE_URL=http://localhost:5001
TRACKING_BASE_URL=http://localhost:5001

# Comma-separated browser origins allowed to call this API
CORS_ORIGIN=http://localhost:5001,http://localhost:5173

# Port
PORT=5001

# System from email
SYSTEM_VERIFIED_FROM_EMAIL=
