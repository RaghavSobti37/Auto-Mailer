# ============================================================
# Auto-Mailer — Standalone Environment Configuration
# ============================================================
# Copy this file to .env and fill in your settings.
# All data is stored locally in Docker MongoDB.

# --- Local Data Services (Docker) ---
MONGODB_URI=mongodb://localhost:27017/auto-mailer
REDIS_URL=redis://localhost:6379

# --- Email Sending (Resend — get your key at https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Server ---
PORT=5001
FRONTEND_URL=http://localhost:5001
CORS_ORIGIN=*

# --- Sender Identity ---
SYSTEM_VERIFIED_FROM_EMAIL=onboarding@resend.dev

# --- SMTP Fallback (optional) ---
SMTP_USER=
SMTP_PASS=

# --- HolySheet Unsubscribe Sync (optional) ---
HOLYSHEET_API_KEY=
