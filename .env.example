# ============================================================
# Auto-Mailer — Environment Configuration (Production)
# ============================================================

# --- Data Sources ---
MONGODB_URI=mongodb://localhost:27017/auto-mailer

# --- Optional Online Backup ---
# Local MongoDB is the source of truth. Use Settings -> Back up now to write
# compressed gzip/EJSON chunks into this online MongoDB database.
ONLINE_BACKUP_MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/auto-mailer-backup

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Email Sending ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
SMTP_USER=
SMTP_PASS=

# --- Server ---
PORT=5001
FRONTEND_URL=http://localhost:5001
TRACKING_BASE_URL=https://auto-mailer-5e54.onrender.com
CORS_ORIGIN=*
NEXT_PUBLIC_LIVE_API_URL=https://auto-mailer-5e54.onrender.com
NEXT_PUBLIC_MIRROR_API_URL=https://auto-mailer-5e54.onrender.com

# --- Sender Identity ---
SYSTEM_VERIFIED_FROM_EMAIL=onboarding@resend.dev
SYSTEM_VIA_REPLY_TO=

# --- Auth ---
AUTO_MAILER_API_KEY=dev-key-123

# --- UploadThing banner uploads ---
# Keep the real token only in .env / hosting secrets. Do not commit live tokens.
UPLOADTHING_TOKEN=eyJhcGlLZXkiOiJza19saXZlX3...placeholder

# --- HolySheet (optional) ---
HOLYSHEET_API_KEY=
