{
    "name": "auto-mailer",
    "version": "1.0.0",
    "description": "Email campaign and automation service",
    "main": "server/server.js",
    "scripts": {
        "start": "node server/server.js",
        "dev": "node --watch server/server.js",
        "backup:data-hub": "node scripts/backup-data-hub.js",
        "migrate:from-coreknot": "node scripts/migrate-from-coreknot.mjs",
        "migrate:to-local": "node scripts/migrate-to-local.mjs",
        "data:consolidate-email": "node scripts/consolidate-clean-email-data.mjs",
        "setup:local-mongo": "node scripts/setup-local-mongo.mjs",
        "campaign:dummy": "node scripts/create-dummy-campaign.mjs",
        "test": "node scripts/backup-self-check.js && node scripts/mail-self-check.js && node scripts/transactional-self-check.js && node scripts/audience-read-self-check.js && node --check server/server.js && node --check server/services/dataHubBackupService.js && node --check server/services/backupWorker.js && node --check server/services/syncLocalWorker.js && node --check server/services/audienceReadService.js && node --check server/routes/transactionalRouter.js",
        "vercel-build": "npm run build --prefix frontend"
    },
    "dependencies": {
        "bullmq": "^5.34.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "imap-simple": "^5.1.0",
        "ioredis": "^5.4.1",
        "mailparser": "^3.7.1",
        "mongoose": "^8.8.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^9.0.3",
        "resend": "^4.0.0",
        "uuid": "^11.1.1"
    },
    "overrides": {
        "semver": "7.7.1"
    }
}
